{
  "name": "oscars-whisper",
  "productName": "Oscar's Whisper",
  "version": "0.1.0",
  "description": "Minimal push-to-talk dictation: always-on bar, global hotkey, voice capture, cleanup, paste.",
  "author": "Oscar",
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "fetch-model": "node scripts/fetch-model.mjs",
    "prestart": "npm run fetch-model",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "predist": "npm run fetch-model",
    "dist": "electron-builder",
    "predist:win": "npm run fetch-model",
    "dist:win": "electron-builder --win --x64",
    "predist:mac": "npm run fetch-model",
    "dist:mac": "ln -sfn \"$PWD\" \"$TMPDIR/oscars-whisper\" && electron-builder --projectDir \"$TMPDIR/oscars-whisper\" --mac --arm64",
    "predist:linux": "npm run fetch-model",
    "dist:linux": "electron-builder --linux --x64"
  },
  "build": {
    "appId": "io.github.oscallen-creator.oscars-whisper",
    "executableName": "OscarsWhisper",
    "artifactName": "OscarsWhisper-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "models/parakeet-tdt-0.6b-v2-int8",
        "to": "models/parakeet-tdt-0.6b-v2-int8",
        "filter": [
          "*.onnx",
          "tokens.txt"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "npmRebuild": false,
    "publish": null,
    "win": {
      "target": "nsis",
      "files": [
        "!node_modules/sherpa-onnx-{darwin,linux}-*/**",
        "!node_modules/sherpa-onnx-win-ia32/**"
      ]
    },
    "nsis": {
      "artifactName": "OscarsWhisper-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Oscar's Whisper records your voice while you dictate."
      },
      "files": [
        "!node_modules/sherpa-onnx-{win,linux}-*/**"
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "files": [
        "!node_modules/sherpa-onnx-{win,darwin}-*/**"
      ]
    }
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.8",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "tar": "7.5.22",
    "unbzip2-stream": "1.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "electron-winstaller@5.4.0": false,
    "uiohook-napi@1.5.5": true
  }
}
